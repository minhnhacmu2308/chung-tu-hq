# --- Cơ sở dữ liệu ---
DATABASE_URL=postgres://kb_app:kb_app@localhost:5433/khaibao
DATABASE_ADMIN_URL=postgres://kb_admin:kb_admin@localhost:5433/khaibao
# Khu Quản trị hệ thống (role kb_platform, BYPASSRLS – ADR 0006). Bỏ trống → DATABASE_URL với user kb_platform, cùng mật khẩu.
DATABASE_PLATFORM_URL=
REDIS_URL=redis://localhost:6379
# --- Lưu file: STORAGE=s3 (MinIO dev / R2) hoặc azure (Azure Blob Storage) ---
STORAGE=s3
# Azure: Portal → Storage account → Security + networking → Access keys → Connection string (phải có AccountKey).
AZURE_STORAGE_CONNECTION_STRING=
# Container riêng tư, tự tạo nếu chưa có (a-z, 0-9, dấu -).
AZURE_STORAGE_CONTAINER=khaibao-documents
# S3 (chỉ cần khi STORAGE=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=khaibao-dev
S3_ACCESS_KEY_ID=kb_minio
S3_SECRET_ACCESS_KEY=kb_minio_secret
S3_REGION=auto
S3_FORCE_PATH_STYLE=true
# --- Bí mật ứng dụng ---
# base64 của 32 byte; sinh bằng: openssl rand -base64 32
APP_MASTER_KEY=
APP_URL=http://localhost:3100
# --- Adapter (dev/test luôn là fake) ---
AI_PROVIDER=fake
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5
AI_USD_VND_RATE=25400
# fake: giả lập trong process · fpt: HTTP tới FPT_API_BASE_URL.
# Dev muốn thử HTTP thật: chạy `pnpm fpt-mock` rồi đặt CUSTOMS_GATEWAY=fpt, FPT_API_BASE_URL=http://localhost:7070, FPT_API_USERNAME=test, FPT_API_PASSWORD=test.
# KHÔNG trỏ FPT_API_BASE_URL tới cổng FPT thật khi dev/test – cổng thật là production.
CUSTOMS_GATEWAY=fake
FPT_API_BASE_URL=
FPT_API_USERNAME=
FPT_API_PASSWORD=
FPT_API_TIMEOUT_MS=60000
# Tài khoản VNACCS chung khi doanh nghiệp chưa nhập tài khoản riêng (chỉ dev với fpt-mock; mật khẩu mock: 12345678)
FPT_VNACCS_USER_ID=
FPT_VNACCS_PASSWORD=
FPT_VNACCS_TERMINAL_ID=
FPT_VNACCS_TERMINAL_ACCESS_KEY=
# Phân loại HS: fake (theo catalog_hs) | hscodepro. Giả lập HTTP: pnpm fpt-mock → HSCODEPRO_URL=http://localhost:7070, khóa dev-hs-key.
# Thật (dev HSCodePro): HSCODEPRO_URL=https://dev.aixuatnhapkhau.cloud + khóa HSCodePro cấp.
HS_CLASSIFIER=fake
HSCODEPRO_URL=
HSCODEPRO_INTERNAL_KEY=
MAIL=console
SMTP_URL=smtp://localhost:1025
# --- Web ---
# mock: dữ liệu giả trong trình duyệt (demo, Vercel) · http: gọi backend
NEXT_PUBLIC_DATA_SOURCE=mock
