{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommits", "group:allNonMajor"],
  "timezone": "Asia/Ho_Chi_Minh",
  "schedule": ["before 7am on monday"],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "packageRules": [
    { "matchUpdateTypes": ["major"], "dependencyDashboardApproval": true },
    { "matchPackageNames": ["next", "react", "react-dom", "drizzle-orm", "drizzle-kit", "bullmq"], "groupName": "nền tảng (next, react, drizzle, bullmq)" },
    { "matchManagers": ["github-actions", "dockerfile", "docker-compose"], "pinDigests": true }
  ],
  "vulnerabilityAlerts": { "labels": ["security"], "schedule": ["at any time"] }
}
